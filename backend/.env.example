# Backend Environment Variables for Kisan Mitra
# Copy this file to .env and fill in the values

# Port the backend server listens on (default: 4000)
PORT=4000

# In production, set this to the URL of your deployed frontend to
# restrict CORS access:
# FRONTEND_URL=https://kisan-mitra.vercel.app
# Leave empty to allow all origins (dev-friendly):
FRONTEND_URL=
