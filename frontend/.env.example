# Frontend Environment Variables for Kisan Mitra
# Copy this file to .env and fill in the values

# In development (with Vite proxy), leave this empty or omit it entirely.
# In production deployment (e.g. Render, Railway, Vercel), set this to
# the absolute URL of your deployed backend:
# VITE_API_URL=https://kisan-mitra-backend.onrender.com

VITE_API_URL=
